# ClefCut environment variables.
# Copy to your Remotion project's .env file, or to ~/.clefcut/.env for all projects.
# The token needs Workers AI permission (Workers AI - Read; add Edit if it was not
# created from the dashboard template). NEVER commit this file with a real token in it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: route model requests through a Cloudflare AI Gateway (adds logging,
# caching, retries, rate limits). Set to the gateway id, e.g. "default".
# CLEFCUT_GATEWAY_ID=

# Optional: explicit path to an ffmpeg binary, if it is not on PATH.
# CLEFCUT_FFMPEG=
