{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/secondsky/claude-skills/schemas/codex-marketplace.schema.json",
  "title": "Codex CLI Marketplace Schema",
  "description": "JSON schema for validating .agents/plugins/marketplace.json — the Codex CLI marketplace catalog. Generated by generate-codex-manifests.sh.",
  "type": "object",
  "required": ["name", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Marketplace name in kebab-case (e.g., 'claude-skills')."
    },
    "interface": {
      "type": "object",
      "description": "Marketplace-level UX metadata.",
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "shortDescription": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Plugin name in kebab-case."
          },
          "source": {
            "type": "object",
            "required": ["source", "path"],
            "description": "Plugin source — local path relative to marketplace root.",
            "properties": {
              "source": {
                "type": "string",
                "enum": ["local", "git"],
                "description": "Source type: 'local' for relative path, 'git' for remote repo."
              },
              "path": {
                "type": "string",
                "pattern": "^\\./plugins/[^/]+$",
                "description": "Relative path to plugin directory (must start with './plugins/')."
              }
            },
            "additionalProperties": false
          },
          "policy": {
            "type": "object",
            "description": "Installation policy.",
            "properties": {
              "installation": {
                "type": "string",
                "enum": ["NOT_AVAILABLE", "AVAILABLE", "INSTALLED_BY_DEFAULT"]
              },
              "authentication": {
                "type": "string",
                "enum": ["ON_INSTALL", "ON_USE", "NEVER"]
              }
            },
            "additionalProperties": false
          },
          "category": {
            "type": "string",
            "description": "Plugin category (freeform string, Title-Case)."
          }
        }
      }
    }
  }
}
